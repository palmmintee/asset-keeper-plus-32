# ===== Self-hosted Supabase config =====
# IP ของ Server Ubuntu ใน LAN ของคุณ (ผู้ใช้คนอื่นจะเข้าผ่าน URL นี้)
PUBLIC_URL=http://192.168.1.100:8000

# รหัสผ่านฐานข้อมูล (ตั้งให้ปลอดภัย)
POSTGRES_PASSWORD=ChangeThisStrongPassword123!

# JWT Secret - อย่างน้อย 32 ตัวอักษร สุ่มใหม่ก่อนใช้งาน
# สร้างด้วย: openssl rand -base64 48
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-change-me

# JWT Keys - ต้องสร้างให้ตรงกับ JWT_SECRET ด้านบน
# วิธีสร้าง: ดู README หัวข้อ "สร้าง JWT Keys"
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q
