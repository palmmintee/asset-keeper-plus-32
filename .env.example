# ============================================================
#  IT Stock Management - Self-Hosted Environment Variables
#  คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ:  cp .env.example .env
# ============================================================

# URL ของ Supabase API (Kong) ที่ client จะเรียก
# ใช้ IP ของ Ubuntu Server ใน LAN  (port 8000 = Kong)
PUBLIC_URL=http://10.20.10.80:8000

# รหัสผ่าน PostgreSQL — **ต้องเปลี่ยนก่อนใช้จริง**
POSTGRES_PASSWORD=ChangeThisStrongPassword123!

# JWT Secret อย่างน้อย 32 ตัวอักษร — สร้างใหม่ด้วย: openssl rand -base64 48
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-change-me

# JWT Keys (ต้องสอดคล้องกับ JWT_SECRET ด้านบน)
# สร้างใหม่ที่: https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
# (ค่าเริ่มต้นด้านล่างเป็นของ demo secret — ใช้งานทดสอบได้ทันที แต่ไม่ปลอดภัย)
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q
